        "raw": "{\n  \"title\": \"QA T17.6 free workshop\",\n  \"description\": \"Temporary workshop for the payment API checks. No price is sent.\",\n  \"date\": \"2026-12-01\",\n  \"time\": \"10:30 AM\",\n  \"mode\": \"Online\",\n  \"locationOrLink\": \"https://meet.example.com/qa-t17-6\",\n  \"capacity\": 20\n}"
